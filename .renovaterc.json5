{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>LukeEvansTech/renovate-config"],
  packageRules: [
    {
      // This is the image WE build and push, not a dependency we pull.
      // Don't let docker:pinDigests pin a digest onto it — that would turn
      // ${IMAGE}:latest in build-runner-image.yml into an invalid ref.
      matchPackageNames: ["ghcr.io/codelooks-com/packer-runner"],
      enabled: false,
    },
    {
      // ansible-core 2.22 requires Python >= 3.13; the runner image's Python is
      // older, so `mise install` fails in both the runner-image build and
      // build-templates. Hold it on 2.21.x until the image's Python is upgraded,
      // then drop this rule.
      matchManagers: ["mise"],
      matchDepNames: ["ansible-core"],
      allowedVersions: "<2.22",
    },
  ],
}
